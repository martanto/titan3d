# Copy to deploy/.env (git-ignored). All settings use the TITAN3D_ prefix.
# Enable HTTP basic auth (both must be set; /api/health stays open):
# TITAN3D_BASIC_AUTH_USER=pvmbg
# TITAN3D_BASIC_AUTH_PASSWORD=change-me
# Simulations run one at a time by default (each uses every CPU core):
# TITAN3D_MAX_CONCURRENT_RUNS=1
# Upload limits:
# TITAN3D_MAX_UPLOAD_FILE_MB=1024
# TITAN3D_MAX_UPLOAD_FILES=64
