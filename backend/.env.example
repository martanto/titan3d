# Copy to backend/.env and run backend commands from backend/.
# Environment variables override values in .env.

# Server
TITAN3D_HOST=127.0.0.1
TITAN3D_PORT=8000
TITAN3D_LOG_LEVEL=INFO

# Storage defaults resolve from the project root, independent of cwd.
# Leave these unset to retain those defaults. Relative overrides resolve from cwd.
# The following overrides assume commands run from backend/:
# TITAN3D_DATA_DIR=../data
# TITAN3D_BUILTIN_DEM_DIR=../dem
# TITAN3D_FRONTEND_DIST=../frontend/dist
TITAN3D_BUILTIN_DEM_ID=semeru
TITAN3D_BUILTIN_DEM_NAME="Semeru — DEMNAS 0.27″"

# Each simulation uses all available CPU cores by default.
TITAN3D_MAX_CONCURRENT_RUNS=1
TITAN3D_MAX_UPLOAD_FILE_MB=1024
TITAN3D_MAX_UPLOAD_FILES=64

# Lists must use JSON syntax.
TITAN3D_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional HTTP basic auth: enable by setting both values.
# TITAN3D_BASIC_AUTH_USER=your-username
# TITAN3D_BASIC_AUTH_PASSWORD=replace-with-a-strong-password

# Optional version metadata override (normally inferred from git).
# TITAN3D_GIT_COMMIT=your-commit-sha
